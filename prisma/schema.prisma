generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("user")
  leetcode     String    @default("")
  codeforces   String    @default("")
  codechef     String    @default("")
  totalSolved  Int       @default(0)
  todaySolved  Int       @default(0)
  solvedLc     Int       @default(0)
  solvedCf     Int       @default(0)
  solvedCc     Int       @default(0)
  lastUpdated  DateTime  @default(now())
  lastSyncAt   DateTime?
  lastDailyDate String   @default("")
  createdAt    DateTime  @default(now())

  @@index([totalSolved(sort: Desc)])
  @@index([todaySolved(sort: Desc)])
}

model GlobalMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model BugReport {
  id          String   @id @default(uuid())
  userName    String   @default("")
  userEmail   String   @default("")
  coderHandle String   @default("")
  category    String   @default("other")
  message     String
  status      String   @default("open")
  adminNotes  String   @default("")
  deviceInfo  String   @default("")
  pageUrl     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt(sort: Desc)])
}
