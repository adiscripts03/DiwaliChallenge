generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("user")
  leetcode     String    @default("")
  codeforces   String    @default("")
  codechef     String    @default("")
  todaySolved  Int       @default(0)
  solvedLc     Int       @default(0)
  solvedCf     Int       @default(0)
  solvedCc     Int       @default(0)
  lastUpdated  DateTime  @default(now())
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([todaySolved(sort: Desc)])
}

model GlobalMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
